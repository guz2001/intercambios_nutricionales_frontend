---
/**
 * index.astro — Shell de NutriConsulta v2 (mobile-first).
 * Vistas: buscar · detalle · comparar · lista · ajustes (+ hoja de impresión).
 * El contenido dinámico lo pinta src/scripts/app.js en los contenedores con id.
 */
import '../styles/global.css';

const flecha = `<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m15 18-6-6 6-6"/></svg>`;
const lupa = `<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>`;
---

<!doctype html>
<html lang="es" data-theme="light" data-fs="normal">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#faf5ec" />
    <title>NutriConsulta — Tabla de composición de alimentos</title>
    <meta name="description" content="Consulta la composición nutricional de alimentos para nutricionistas." />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Lora:wght@600;700&display=swap"
    />
    <!-- Aplica tema y tamaño de letra antes de pintar (evita parpadeo) -->
    <script is:inline>
      try {
        var s = JSON.parse(localStorage.getItem('nutri.ajustes') || '{}');
        var oscuro = s.tema === 'oscuro' || (s.tema === 'sistema' && matchMedia('(prefers-color-scheme: dark)').matches);
        document.documentElement.dataset.theme = oscuro ? 'dark' : 'light';
        if (s.fs) document.documentElement.dataset.fs = s.fs;
      } catch (e) {}
    </script>
  </head>

  <body>
    <!-- ═══ BUSCAR ═══ -->
    <main class="vista" id="vista-buscar" data-vista="buscar">
      <div class="topbar">
        <div class="marca">
          <svg width="28" height="28" viewBox="0 0 24 24" aria-hidden="true">
            <path d="M12 2C12 2 4 6.5 4 13.5 4 18 7.6 21.5 12 21.5S20 18 20 13.5C20 6.5 12 2 12 2Z" fill="var(--primary)"/>
            <path d="M12 21V11m0 0s-3-2-5-.5" stroke="var(--bg)" stroke-width="1.8" stroke-linecap="round" fill="none"/>
          </svg>
          <span class="marca-nombre">NutriConsulta</span>
        </div>
        <button class="btn-icono" data-ir="ajustes" aria-label="Ajustes de lectura">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M4 7h10M18 7h2M4 17h2M10 17h10"/><circle cx="16" cy="7" r="2"/><circle cx="8" cy="17" r="2"/></svg>
        </button>
      </div>

      <h1 class="titulo-vista" id="titulo-buscar">Buscar alimento</h1>
      <p class="sub" id="sub-buscar">Tabla de composición de alimentos</p>

      <span class="etiqueta" id="lbl-poblacion">Población</span>
      <div class="chips" id="chips-poblacion" role="group" aria-labelledby="lbl-poblacion">
        <button class="chip" data-valor="niños_y_adultos" aria-pressed="true">Niños y adultos</button>
        <button class="chip" data-valor="adultos" aria-pressed="false">Adultos</button>
        <button class="chip" data-valor="niños" aria-pressed="false">Niños</button>
        <button class="chip" data-valor="menores_de_dos_anios" aria-pressed="false">Menores de 2 años</button>
      </div>

      <label class="campo">
        <span class="sr-only">Buscar alimento</span>
        <Fragment set:html={lupa} />
        <input type="search" id="input-busqueda" placeholder="Ej. leche, arroz, pollo…" autocomplete="off" enterkeyhint="search" />
      </label>

      <span class="etiqueta" id="lbl-grupo">Grupo de alimentos</span>
      <div class="chips" id="chips-grupo" role="group" aria-labelledby="lbl-grupo">
        <button class="chip" data-valor="" aria-pressed="true">Todos</button>
        <!-- grupos cargados por app.js desde /api/grupos/ -->
      </div>

      <p class="contador-resultados" id="contador-resultados" aria-live="polite"></p>
      <div id="lista-alimentos"></div>
    </main>

    <!-- ═══ DETALLE ═══ -->
    <main class="vista con-barra" id="vista-detalle" data-vista="detalle" hidden>
      <div class="topbar">
        <button class="btn btn-volver" data-volver><Fragment set:html={flecha} /> Volver</button>
        <span class="topbar-nota">Información nutricional</span>
      </div>
      <div id="detalle-contenido"></div>
      <div class="barra-accion">
        <div class="barra-accion-in">
          <button class="btn" id="btn-comparar">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M8 3v18M16 3v18M4 8h8M12 16h8"/></svg>
            Comparar
          </button>
          <button class="btn btn-primario" id="btn-agregar">+ Agregar</button>
          <p>Se suma a los totales de tu lista de trabajo</p>
        </div>
      </div>
    </main>

    <!-- ═══ COMPARAR ═══ -->
    <main class="vista con-barra" id="vista-comparar" data-vista="comparar" hidden>
      <div class="topbar">
        <button class="btn btn-volver" data-volver><Fragment set:html={flecha} /> Volver</button>
        <span class="topbar-nota" id="comp-nota"></span>
      </div>
      <h1 class="titulo-vista">Comparar alimentos</h1>
      <div id="comparar-contenido"></div>
      <div class="barra-accion">
        <div class="barra-accion-in" style="grid-template-columns:1fr 1fr">
          <button class="btn btn-verde" id="btn-add-a">Agregar A</button>
          <button class="btn btn-acento" id="btn-add-b">Agregar B</button>
        </div>
      </div>
    </main>

    <!-- ═══ MI LISTA ═══ -->
    <main class="vista" id="vista-lista" data-vista="lista" hidden>
      <div id="lista-contenido"></div>
    </main>

    <!-- ═══ AJUSTES ═══ -->
    <main class="vista sin-nav" id="vista-ajustes" data-vista="ajustes" hidden>
      <div class="topbar" style="justify-content:flex-start">
        <button class="btn-icono" data-volver aria-label="Volver"><Fragment set:html={flecha} /></button>
        <h1 class="titulo-vista" style="margin:0">Ajustes de lectura</h1>
      </div>

      <span class="etiqueta" id="lbl-fs">Tamaño de letra</span>
      <div class="fs-grid" role="radiogroup" aria-labelledby="lbl-fs" id="ajuste-fs">
        <button class="fs-op" role="radio" data-fs="normal" aria-checked="true"><span class="aa" style="font-size:1.1rem">Aa</span>Normal</button>
        <button class="fs-op" role="radio" data-fs="grande" aria-checked="false"><span class="aa" style="font-size:1.4rem">Aa</span>Grande</button>
        <button class="fs-op" role="radio" data-fs="muy-grande" aria-checked="false"><span class="aa" style="font-size:1.75rem">Aa</span>Muy grande</button>
      </div>

      <span class="etiqueta" id="lbl-tema">Apariencia</span>
      <div role="radiogroup" aria-labelledby="lbl-tema" id="ajuste-tema">
        <button class="tema-op" role="radio" data-tema="claro" aria-checked="true">Claro <span class="radio"></span></button>
        <button class="tema-op" role="radio" data-tema="oscuro" aria-checked="false">Oscuro <span class="radio"></span></button>
        <button class="tema-op" role="radio" data-tema="sistema" aria-checked="false">Igual que el teléfono <span class="radio"></span></button>
      </div>

      <span class="etiqueta">Vista previa</span>
      <div class="prev">
        <div class="tarjeta-fila">
          <div>
            <div class="tarjeta-nombre">Leche entera</div>
            <div class="tarjeta-meta">Lácteos · Porción 240 g</div>
          </div>
          <div class="tarjeta-kcal"><strong>150</strong><span>kcal</span></div>
        </div>
        <div class="macros-mini"><span>Proteína <b>8 g</b></span><span>Carbohid. <b>11,7 g</b></span><span>Grasa <b>8 g</b></span></div>
      </div>
      <p class="sub" style="margin-top:0.75rem">Se guarda en este dispositivo y se aplica a toda la app.</p>
    </main>

    <!-- Hoja de impresión (solo visible al imprimir / guardar PDF) -->
    <section class="hoja" id="hoja-impresion" aria-hidden="true"></section>

    <!-- Navegación inferior -->
    <nav class="nav" id="nav" aria-label="Principal">
      <div class="nav-in">
        <button class="nav-btn" data-ir="buscar" id="nav-buscar">
          <Fragment set:html={lupa} /> Buscar
        </button>
        <button class="nav-btn" data-ir="lista" id="nav-lista">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M9 6h11M9 12h11M9 18h11M4 6h.01M4 12h.01M4 18h.01"/></svg>
          Mi lista <span class="badge" id="contador-guardados" aria-label="alimentos en la lista">0</span>
        </button>
      </div>
    </nav>

    <div class="toast" id="toast" role="status" aria-live="polite"></div>

    <script>
      import '../scripts/app.js';
    </script>
  </body>
</html>
